# The image ships with NO ssh host keys (they'd be identical on every
# installed server — a real MITM hazard). Each machine mints its own on
# first boot, before sshd starts.
[Unit]
Description=Generate this machine's SSH host keys
Before=ssh.service
ConditionPathExists=!/etc/ssh/ssh_host_ed25519_key

[Service]
Type=oneshot
ExecStart=/usr/bin/ssh-keygen -A
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
